if(BUILD_TESTING AND RNC_INTEROP_TESTS)
    if(NOT UNIX)
        message(FATAL_ERROR "The live oracle harness currently requires POSIX process/socket APIs")
    endif()
    find_package(Python3 REQUIRED COMPONENTS Interpreter)
    find_package(Git REQUIRED)
    execute_process(COMMAND ${GIT_EXECUTABLE} -C "${RNC_REFERENCE_DIR}" rev-parse HEAD
        OUTPUT_VARIABLE rns_head OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE rns_git_status)
    if(NOT rns_git_status EQUAL 0 OR NOT rns_head STREQUAL "e40191b3d193b46b7f2d8a44424a594cd758839b")
        message(FATAL_ERROR "Live oracle requires RNS 1.5.5 commit e40191b3d193b46b7f2d8a44424a594cd758839b")
    endif()
    execute_process(COMMAND ${GIT_EXECUTABLE} -C "${RNC_REFERENCE_DIR}" diff HEAD --quiet -- RNS Examples/Channel.py
        RESULT_VARIABLE rns_modified)
    if(NOT rns_modified EQUAL 0)
        message(FATAL_ERROR "Live oracle source must be unmodified")
    endif()
    add_executable(test_rnc_interop ${PROJECT_SOURCE_DIR}/tests/test_interop.c)
    target_link_libraries(test_rnc_interop PRIVATE reticulum_c OpenSSL::Crypto)
    target_compile_options(test_rnc_interop PRIVATE -Wall -Wextra -Wpedantic -Werror)
    foreach(role client server loss)
        add_test(NAME reticulum_live_${role} COMMAND ${CMAKE_COMMAND} -E env
            "PYTHONPATH=${RNC_REFERENCE_DIR}:${RNC_INTEROP_PYTHONPATH}"
            $<TARGET_FILE:test_rnc_interop> ${Python3_EXECUTABLE} "${RNC_REFERENCE_DIR}/Examples/Channel.py" ${role})
        set_tests_properties(reticulum_live_${role} PROPERTIES TIMEOUT 30 LABELS "reticulum_interop;network")
    endforeach()
    add_executable(test_rnc_mesh_interop ${PROJECT_SOURCE_DIR}/tests/test_interop.c)
    target_compile_definitions(test_rnc_mesh_interop PRIVATE RNC_ROUTED_INTEROP=1)
    target_link_libraries(test_rnc_mesh_interop PRIVATE reticulum_c OpenSSL::Crypto)
    foreach(role client server loss)
        add_test(NAME reticulum_mesh_${role} COMMAND ${CMAKE_COMMAND} -E env
            "PYTHONPATH=${RNC_REFERENCE_DIR}:${RNC_INTEROP_PYTHONPATH}"
            $<TARGET_FILE:test_rnc_mesh_interop> ${Python3_EXECUTABLE} "${RNC_REFERENCE_DIR}/Examples/Channel.py" ${role})
        set_tests_properties(reticulum_mesh_${role} PROPERTIES TIMEOUT 30 LABELS "reticulum_interop;network")
    endforeach()
    find_package(Python3 REQUIRED COMPONENTS Interpreter Development)
    add_executable(test_security_oracle ${PROJECT_SOURCE_DIR}/tests/test_security_oracle.c)
    target_link_libraries(test_security_oracle PRIVATE reticulum_c OpenSSL::Crypto Python3::Python)
    add_test(NAME reticulum_security_oracle COMMAND test_security_oracle
        "${RNC_REFERENCE_DIR}" "${Python3_SITELIB}")
    set_tests_properties(reticulum_security_oracle PROPERTIES LABELS reticulum_interop)
    add_executable(test_services_interop ${PROJECT_SOURCE_DIR}/tests/test_services_interop.c)
    target_link_libraries(test_services_interop PRIVATE reticulum_c OpenSSL::Crypto Python3::Python)
    set(service_modes send receive segments service_client service_server service_bulk_client service_bulk_server large_send large_receive large_service_client large_service_server large_service_bulk_client large_service_bulk_server)
    if(RNC_COMPRESSION)
        list(APPEND service_modes send_compressed receive_compressed)
    endif()
    foreach(mode IN LISTS service_modes)
        add_test(NAME reticulum_differential_${mode} COMMAND test_services_interop
            "${RNC_REFERENCE_DIR}" ${mode} "${Python3_SITELIB}")
        set_tests_properties(reticulum_differential_${mode} PROPERTIES LABELS "reticulum_interop;differential" TIMEOUT 60)
    endforeach()
endif()
