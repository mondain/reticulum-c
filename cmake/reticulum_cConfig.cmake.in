@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
if("@RNC_CRYPTO@" STREQUAL "openssl")
    find_dependency(OpenSSL 3.0 COMPONENTS Crypto)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/reticulum_cTargets.cmake")
check_required_components(reticulum_c)

if(@RNC_COMPRESSION@)
    find_dependency(BZip2)
endif()
