option(RNC_LEVICULUM_TESTS "Run C harness against an external pinned Leviculum library" OFF)
set(RNC_LEVICULUM_REFERENCE_DIR "" CACHE PATH "Pinned Leviculum source checkout")
set(RNC_LEVICULUM_LIBRARY "" CACHE FILEPATH "External libleviculum shared library")
if(BUILD_TESTING AND RNC_LEVICULUM_TESTS)
    if(NOT CMAKE_SYSTEM_NAME STREQUAL "Linux")
        message(FATAL_ERROR "The optional Leviculum C oracle currently requires Linux")
    endif()
    find_package(Git REQUIRED)
    find_package(Threads REQUIRED)
    execute_process(COMMAND ${GIT_EXECUTABLE} -C "${RNC_LEVICULUM_REFERENCE_DIR}" rev-parse HEAD
        OUTPUT_VARIABLE lev_head OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE status)
    if(NOT status EQUAL 0 OR NOT lev_head STREQUAL "395edd42fbbffcdfb438fcd80afa17668459d331")
        message(FATAL_ERROR "Leviculum oracle requires commit 395edd42fbbffcdfb438fcd80afa17668459d331")
    endif()
    execute_process(COMMAND ${GIT_EXECUTABLE} -C "${RNC_LEVICULUM_REFERENCE_DIR}" diff HEAD --quiet
        RESULT_VARIABLE status)
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "Leviculum reference source must be unmodified")
    endif()
    if(NOT EXISTS "${RNC_LEVICULUM_LIBRARY}" OR NOT EXISTS "${RNC_LEVICULUM_REFERENCE_DIR}/leviculum-ffi/leviculum.h")
        message(FATAL_ERROR "Build the external Leviculum FFI library/header before configuring its optional tests")
    endif()
    add_library(rnc_leviculum_oracle SHARED IMPORTED)
    set_target_properties(rnc_leviculum_oracle PROPERTIES IMPORTED_LOCATION "${RNC_LEVICULUM_LIBRARY}")
    add_executable(test_leviculum tests/test_leviculum.c)
    target_include_directories(test_leviculum PRIVATE "${RNC_LEVICULUM_REFERENCE_DIR}/leviculum-ffi")
    target_link_libraries(test_leviculum PRIVATE reticulum_c rnc_leviculum_oracle OpenSSL::Crypto Threads::Threads)
    target_compile_options(test_leviculum PRIVATE -Wall -Wextra -Wpedantic -Werror)
    foreach(role client server loss)
        add_test(NAME leviculum_live_${role} COMMAND test_leviculum ${role})
        set_tests_properties(leviculum_live_${role} PROPERTIES TIMEOUT 40 LABELS "leviculum_interop;network")
    endforeach()
endif()
